{"overview":{"Symbol":"VMET","Name":"Versamet Royalties Corporation","Description":"Versamet Royalties Corporation operates as metals royalty and streaming company, engages in the acquiring and managing royalties, streams, and other similar interests on metals and mining operations and projects in Peru, the United States, Africa, and Canada. It explores for silver, gold, copper, graphite, lead, uranium, zinc, and molybdenum metals. Versamet Royalties Corporation was formerly known as Sandbox Royalties Corp. and changed its name to Versamet Royalties Corporation in June 2024. The company was incorporated in 2011 and is based in Vancouver, Canada.","CIK":"","Exchange":"NasdaqCM","Currency":"USD","Country":"Canada","Sector":"Basic Materials","Industry":"Other Precious Metals & Mining","Address":"733 Seymour Street, Vancouver, BC, V6B 0S6, Canada","FiscalYearEnd":"","LatestQuarter":"","MarketCapitalization":"1230327424","EBITDA":"67337000","PERatio":"36.548386","PEGRatio":"","BookValue":"2.505","DividendPerShare":"","DividendYield":"","EPS":"0.31","RevenuePerShareTTM":"0.584","ProfitMargin":"0.58444","OperatingMarginTTM":"0.90558","ReturnOnAssetsTTM":"0.109110005","ReturnOnEquityTTM":"0.11153","RevenueTTM":"55275000","GrossProfitTTM":"37234000","DilutedEPSTTM":"0.31","QuarterlyEarningsGrowthYOY":"6.711","QuarterlyRevenueGrowthYOY":"5.939","AnalystTargetPrice":"","TrailingPE":"36.548386","ForwardPE":"","PriceToSalesRatioTTM":"22.258299","PriceToBookRatio":"4.522954","EVToRevenue":"20.308","EVToEBITDA":"16.67","Beta":"","52WeekHigh":"15","52WeekLow":"9.1","50DayMovingAverage":"11.857","200DayMovingAverage":"11.394507","SharesOutstanding":"108590241","DividendDate":"","ExDividendDate":"","DebtToEquity":"12.304"},"daily":{"Meta Data":{"1. Information":"Daily Time Series (Yahoo Finance, shaped like Alpha Vantage)","2. Symbol":"VMET","3. Last Refreshed":"2026-10-16","4. Output Size":"Compact"},"Time Series (Daily)":{"2026-03-23":{"1. open":"10.34000015258789","2. high":"10.68