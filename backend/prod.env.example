ALPHA_VANTAGE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
MONGODB_URI=
PORT=10000
TRUST_PROXY_HOPS=1

REQUIRE_ACTIVE_SUBSCRIPTION=true
# New website registrations pay through Stripe before access is activated.
# Set false only for a controlled rollback or local legacy-trial test.
REQUIRE_INITIAL_STRIPE_PAYMENT=true
INITIAL_REFUND_DAYS=7

STRIPE_ACCOUNT_ID=acct_1TDj4gAUeKapY1OP
# Set these to the active live Stripe Prices. Keep Price IDs out of Git.
STRIPE_PRICE_ID=price_REPLACE_WITH_MONTHLY
STRIPE_PRICE_ID_MONTHLY=price_REPLACE_WITH_MONTHLY
STRIPE_PRICE_ID_ANNUAL=price_REPLACE_WITH_ANNUAL
STRIPE_PRICE_ID_PRO=price_REPLACE_WITH_PRO_MONTHLY
STRIPE_PRICE_ID_PRO_ANNUAL=price_REPLACE_WITH_PRO_ANNUAL
# Professional tiers. If omitted, the server resolves one exact active USD
# Stripe price by amount, product name and recurring interval.
STRIPE_PRICE_ID_POWER=price_REPLACE_WITH_POWER_YEARLY
STRIPE_PRICE_ID_POWER_MONTHLY=price_REPLACE_WITH_POWER_MONTHLY
STRIPE_PRICE_ID_DESK=price_REPLACE_WITH_DESK_YEARLY
# Display/record prices — must match the Stripe Price amounts above.
CORE_PLAN_CURRENCY=USD
CORE_PLAN_PRICE=12.00
ANNUAL_PLAN_CURRENCY=USD
ANNUAL_PLAN_PRICE=118.00
PRO_PLAN_PRICE=33.00
PRO_ANNUAL_PLAN_PRICE=250.00
POWER_PLAN_CURRENCY=USD
POWER_PLAN_PRICE=579.00
POWER_MONTHLY_PLAN_CURRENCY=USD
POWER_MONTHLY_PLAN_PRICE=64.00
DESK_PLAN_CURRENCY=USD
DESK_PLAN_PRICE=1961.00
TRIAL_DAYS=0
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_WEBHOOK_SECRET=

# --- AppSumo Licensing API v2 (lifetime-deal redemption) ---
# From the AppSumo Partner Portal once both URLs are validated. While these are
# blank the webhook still returns 200 for AppSumo's URL-validation test events,
# but HMAC enforcement and OAuth code exchange are skipped (set them before go-live).
#   Webhook URL  -> https://www.stockportfolio.pro/appsumo/webhook
#   OAuth URL    -> https://www.stockportfolio.pro/appsumo/redeem
APPSUMO_API_KEY=
APPSUMO_CLIENT_ID=
APPSUMO_CLIENT_SECRET=
APPSUMO_REDIRECT_URI=https://www.stockportfolio.pro/appsumo/redeem
# Live AppSumo slug used by post-purchase review links.
APPSUMO_PRODUCT_SLUG=stockportfoliopro
# Set to 0 only if review/onboarding emails must be paused. Stages 2 and 3 are
# sent only after the buyer has recorded at least one Ask use.
APPSUMO_REVIEW_EMAILS=1
# Optional official AppSumo HTTPS tracking/deal URL. For safety this must use
# appsumo.com or one of its subdomains; invalid values fall back to the live deal.
# This example preserves the attributed URL already used by the live site's
# AppSumo partner badge. Confirm the approved destination in Partner Portal.
APPSUMO_ATTRIBUTED_URL=https://appsumo.com/products/stockportfoliopro/?utm_source=partner-badge&utm_medium=referral&utm_campaign=partner-255732

# Email (customer lifecycle + owner notifications). Customer-facing messages
# always use StockPortfolio.pro Support <support@stockportfolio.pro> as both the
# From and default Reply-To identity. Configure SMTP to authorize that mailbox.
# If these are blank, signup still works but no emails are sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@stockportfolio.pro
SMTP_PASS=
SUPPORT_INBOX_EMAIL=support@stockportfolio.pro
OWNER_NOTIFICATION_EMAIL=avinashsreekumar007@gmail.com
APP_PUBLIC_URL=https://www.stockportfolio.pro
# Optional high-entropy token for marking automated marketing smoke tests as QA.
# Human QA can instead use the rin@gmail.com dashboard toggle. Never expose this
# value in a URL, client bundle, log, or repository.
MARKETING_QA_TOKEN=

# --- Customer ambassador referral MVP (disabled by default) ---
# Set to true only after the reconciliation report and manual support workflow
# are approved. Release 1 sends no invitations and performs no payouts.
AFFILIATE_PROGRAM_ENABLED=false
AFFILIATE_COOKIE_SECRET=
AFFILIATE_ATTRIBUTION_DAYS=60
APPSUMO_NEW_BUYER_URL=

# --- DealMirror controlled LTD pilot (dark by default) ---
# Keep disabled until both AppSumo and DealMirror approve the written price-floor,
# inventory and agreement gates. The absolute cap is hard-coded to 100 and cannot
# be increased by this file. Pepper is secret-manager only; never commit it.
DEALMIRROR_CAMPAIGN_ENABLED=false
DEALMIRROR_INITIAL_CAP=50
DEALMIRROR_ABSOLUTE_CAP=100
DEALMIRROR_REDEMPTION_DAYS=60
DEALMIRROR_SECOND_BATCH_APPROVED=false
DEALMIRROR_CODE_PEPPER=
DEALMIRROR_CAMPAIGN_SALES_END_AT=
# Must be outside the repository; generated CSVs are mode 600 and plaintext is
# shown only in those one-time exports.
DEALMIRROR_EXPORT_DIR=/var/tmp/stockportfolio-dealmirror

# --- AI weekly briefing (optional) ---
# Without a key, the dashboard shows a deterministic template briefing.
# With a key, an LLM turns the (deterministically computed) facts into prose.
# Ollama Cloud, using its OpenAI-compatible endpoint.
OLLAMA_API_KEY=
AI_MODEL_CHAT=glm-5.1
AI_MODEL_SUMMARY=glm-5.1
AI_MODEL_BRIEFING=glm-5.1
AI_BRIEFING_BASE_URL=https://ollama.com/v1
# OpenAI-compatible fallback — works with OpenRouter, Moonshot/Kimi, Ollama Cloud, etc.
AI_BRIEFING_API_KEY=
AI_BRIEFING_BASE_URL=https://ollama.com/v1
AI_BRIEFING_MODEL=moonshotai/kimi-k2.6

# Dossier generation is on-demand by default. Enabling this schedules a daily
# background build across PREWARM_TICKERS and can consume substantial AI usage.
PREWARM=off
PREWARM_TICKERS=300

# Anonymous AI teaser: 3 free filing-grounded questions before the signup wall.
# Set ALLOW_ANON_AI=false to disable entirely (restores signup-required Ask).
ALLOW_ANON_AI=true
ANON_ASK_LIMIT=3
NEWS_IMAGE_ALLOWED_HOSTS=*.yimg.com,*.yahoo.com,*.yahooapis.com

# --- Pro AI tier ---
# Kept here for deployments that group AI settings separately; it must match
# the self-serve Pro price declared above.
PRO_PLAN_PRICE=33.00
STRIPE_PRICE_ID_PRO=
# Set AI_PRO_FOR_ALL=false to restrict AI features to paid Pro subscribers only.
# Default (unset/true) gives every active subscriber the AI features.
AI_PRO_FOR_ALL=true
# August AppSumo sprint (no secrets; leave the deadline blank until the live
# listing's exact end time is confirmed).
APPSUMO_CAMPAIGN_ID=appsumo_aug_2026
APPSUMO_AUGUST_CAMPAIGN_ENABLED=true
APPSUMO_CAMPAIGN_START_AT=2026-08-01T00:00:00.000Z
APPSUMO_DEAL_END_AT=
APPSUMO_DEAL_END_TIMEZONE=UTC
APPSUMO_SALES_VIDEO_URL=
APPSUMO_ONBOARDING_VIDEO_URL=
APPSUMO_COUNTDOWN_ENABLED=true
MARKETING_INTERNAL_EMAILS=

# ---- Direct lifetime deal (#9): the AppSumo LTD sold from our own site ----
# Off until every value below is set AND the price floor passes.
DIRECT_LTD_ENABLED=false
# Stripe one-time Price IDs. START IN TEST MODE (price_... created under the
# test key). Switching these to live-mode Prices is a deliberate human
# decision, not a config tidy-up: it is the moment this starts taking real
# money. Do not flip DIRECT_LTD_ENABLED=true against live Prices until the
# direct-vs-AppSumo pricing has been re-confirmed against the partner
# agreement.
STRIPE_PRICE_ID_LTD_STARTER=
STRIPE_PRICE_ID_LTD_INVESTOR=
STRIPE_PRICE_ID_LTD_PRO=
# EXCLUSIVITY / MFN GUARD. The AppSumo listing price for each tier. Direct
# prices ($39.99/$79.99/$149.99) must stay strictly ABOVE these so AppSumo
# remains the cheapest place to buy this deal. If AppSumo pricing ever
# changes, update these: the runtime guard re-reads them on boot and on every
# checkout, and BLOCKS direct sales for any tier that would undercut or match
# AppSumo. Leave blank to use the hard-coded listing prices (39/79/149).
APPSUMO_TIER1_PRICE_USD=
APPSUMO_TIER2_PRICE_USD=
APPSUMO_TIER3_PRICE_USD=
