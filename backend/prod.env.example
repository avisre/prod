# Email (new-user onboarding + owner notification). SMTP via nodemailer.
# Gmail: enable 2-Step Verification, create a 16-char App Password, then:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=you@gmail.com   SMTP_PASS=<16-char app password>
# If these are blank, signup still works but no emails are sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Stock Portfolio Pro <no-reply@stockportfolio.pro>
OWNER_NOTIFICATION_EMAIL=avinashsreekumar007@gmail.com
APP_PUBLIC_URL=https://stockportfolio.pro
