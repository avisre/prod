# --- Secrets / env ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
backend/prod.env

# --- Python ---
# The scripts/ operator scripts need `requests`. Homebrew's python3 is
# externally managed (PEP 668) so it refuses user installs; use .venv/bin/python3.
.venv/
venv/
__pycache__/

# --- Node ---
node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Logs ---
*.log
logs/
backend/*.log
backend/local-server*.log
backend/server.*.log
backend/startup.*.log

# --- Local-only dev artifacts (preview helpers, debug pages) ---
backend/start-preview.js
backend/_verify-seed.js
frontend/_preview.html
frontend/_debug.html

# Underscore-prefixed local scratch: benchmarks, harnesses, token minters,
# one-off probes. NEVER push (the repo goes public during deploy). Some hold
# secrets (_bench.js). Real source never uses a leading underscore here.
/_*.js
backend/_*.js

# tmp-* is the same convention under a different prefix — one-off session
# scripts. NEVER push: they carry live customer email addresses and send
# receipts (tmp-resend-receipt-*.txt) and query password/Google-ID columns.
backend/tmp-*
scripts/__pycache__/

# --- Build / cache ---
.cache/
dist/
build/
.next/
.parcel-cache/
.tools/
# The OpenAI plugin ZIP is rebuilt from openai-plugin/ by
# scripts/build-openai-plugin.sh; the version it carries lives in plugin.json.
openai-plugin.zip

# --- Coverage / test output ---
coverage/
.nyc_output/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# --- Stray / scratch ---
=350
magick-list.html
old_update_block.txt
temp_updatePortfolio.txt
tmp/
temp/
*.tmp

# Local marketing kit — never push (repo goes public during deploy)
marketing/
dealmirror-exports/

# MCP server runtime quota counters (per-deploy state, never shared)
mcp-server/data/quota.json
mcp-server/data/*.tmp

# --- Transient IndexNow state ---
# Written by refresh-fundamentals.js, drained by indexnow-ping.js --queue, in the
# same job. It is per-run scratch, not a record: a copy tracked here sat frozen at
# 9 URLs from 2026-09-11 while the workflow comment claimed it was never committed.
# The comment now matches the file.
seo-data/indexnow-queue.json

# --- Customer data: never commit ---
# Outreach recipient lists and send ledgers carry paying customers' email
# addresses and private notes on what each person said. Git history is
# effectively permanent, so these stay on disk only. The .example files show
# the shape and ARE committed.
scripts/.sent-*.json
scripts/.recipients-*.json
!scripts/.recipients-*.json.example
